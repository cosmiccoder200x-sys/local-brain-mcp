{
  "name": "local-brain-mcp",
  "version": "1.3.1",
  "description": "Shared, local-first memory layer for multi-agent software development (Claude Code, Cursor, Antigravity, Copilot, Windsurf & Zed)",
  "type": "module",
  "main": "dist/mcp-server.js",
  "types": "dist/mcp-server.d.ts",
  "bin": {
    "local-brain": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "npm run build && node --test tests/*.test.js tests/unit/*.test.js tests/integration/*.test.js",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "eval": "npm run build && node scripts/evaluate-retrieval.mjs",
    "start": "node dist/mcp-server.js",
    "init": "node dist/cli.js init",
    "ingest": "node dist/cli.js ingest",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmiccoder200x-sys/local-brain-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cosmiccoder200x-sys/local-brain-mcp/issues"
  },
  "homepage": "https://github.com/cosmiccoder200x-sys/local-brain-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-memory",
    "multi-agent",
    "local-first",
    "claude-code",
    "cursor",
    "antigravity",
    "copilot",
    "windsurf",
    "vector-search",
    "sqlite"
  ],
  "license": "MIT"
}
