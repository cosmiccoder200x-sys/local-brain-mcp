{
  "name": "local-brain-mcp",
  "version": "1.1.0",
  "description": "Local-first, zero-latency, git-aware AI memory MCP server for Claude Code, Cursor, Copilot & Windsurf",
  "type": "module",
  "main": "dist/mcp-server.js",
  "types": "dist/mcp-server.d.ts",
  "bin": {
    "local-brain": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-schema.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/mcp-server.js",
    "init": "node dist/cli.js init",
    "ingest": "node dist/cli.js ingest",
    "clean": "rimraf dist",
    "test": "npm run build && node --test tests/*.test.js",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "eval": "npm run build && node scripts/evaluate-retrieval.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmiccoder200x-sys/local-brain-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cosmiccoder200x-sys/local-brain-mcp/issues"
  },
  "homepage": "https://github.com/cosmiccoder200x-sys/local-brain-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.14.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-memory",
    "local-first",
    "claude-code",
    "cursor",
    "copilot",
    "windsurf",
    "vector-search",
    "sqlite"
  ],
  "license": "MIT"
}
