# local-brain-mcp Configuration (.env)
# All environment variables are optional.

# Path override for SQLite brain database.
# Default: <gitRoot>/.git/brain.db or ~/.config/local-brain/brain.db
# LOCAL_BRAIN_DB_PATH="./.git/brain.db"

# Agent identity override (detected automatically from IDE environment).
# Useful for custom agents or CLI usage.
# LOCAL_BRAIN_AGENT="my-agent"

# Debug logging. Set to a comma-separated list of namespaces to enable.
# Examples:
#   DEBUG="local-brain:*"            — all debug output
#   DEBUG="local-brain:db,local-brain:ingest" — specific namespaces
# Namespaces: db, ingest, recall, invalidation, mcp, cli, provenance
# DEBUG="local-brain:*"

# NODE_ENV="development"

# ─── Tunable Thresholds (optional) ─────────────────────────────────────────────
# Override default behavior via environment variables.

# Max tokens returned in a single recall response (default: 250)
# LOCAL_BRAIN_MAX_TOKENS=250

# Half-life in days for recency/freshness decay (default: 120)
# LOCAL_BRAIN_FRESHNESS_HALF_LIFE=120

# Similarity threshold for duplicate detection (default: 0.90)
# LOCAL_BRAIN_DUP_THRESHOLD=0.90

# Similarity threshold for contradiction detection (default: 0.35)
# LOCAL_BRAIN_CONTRADICTION_THRESHOLD=0.35

# Max characters for a single lesson (default: 10000)
# LOCAL_BRAIN_MAX_LESSON_LENGTH=10000

# Stale change threshold for invalidation (default: 0.30)
# LOCAL_BRAIN_STALE_THRESHOLD=0.30
