# local-brain-mcp Configuration (.env)
# All environment variables are optional.

# Path override for SQLite brain database.
# Default: <gitRoot>/.git/brain.db or ~/.config/local-brain/brain.db
# LOCAL_BRAIN_DB_PATH="./.git/brain.db"

# Debug logging (optional)
# DEBUG="local-brain:*"
# NODE_ENV="development"
